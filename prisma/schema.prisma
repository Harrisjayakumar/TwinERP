}

model Order {
  id             String      @id @default(uuid())
  organizationId String
  orderNumber    String
  type           String      @default("pos")
  customerId     String?
  status         OrderStatus @default(PENDING)
  items          Json
  subtotal       Decimal     @db.Decimal(12, 2)
